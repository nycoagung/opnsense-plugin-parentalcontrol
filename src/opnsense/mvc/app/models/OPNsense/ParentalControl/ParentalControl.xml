<model>
    <mount>//OPNsense/ParentalControl</mount>
    <version>1.4.0</version>
    <description>Per-device internet access control with schedules</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <alias_name type="TextField">
                <Default>NoInternet</Default>
                <Required>Y</Required>
                <Mask>/^(?!(NoMessaging|Messaging_Servers|NoGaming|Gaming_Servers|Gaming_Exempt|Gaming_UDP_Ports|Gaming_TCP_Ports)$)[a-zA-Z0-9_]{1,25}$/</Mask>
                <ValidationMessage>Letters, digits and underscore only, up to 25 characters, and not NoMessaging, Messaging_Servers, NoGaming, Gaming_Servers, Gaming_Exempt, Gaming_UDP_Ports or Gaming_TCP_Ports, which messaging and gaming blocking use. The companion alias appends &quot;_Local&quot; and pf table names cannot exceed 31.</ValidationMessage>
            </alias_name>
            <kill_states type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </kill_states>
            <messaging_apps type="OptionField">
                <Multiple>Y</Multiple>
                <Default>facebook_instagram,kakaotalk,line,signal,snapchat,telegram,viber,whatsapp</Default>
                <OptionValues>
                    <facebook_instagram>Facebook &amp; Instagram</facebook_instagram>
                    <kakaotalk>KakaoTalk</kakaotalk>
                    <line>LINE</line>
                    <signal>Signal</signal>
                    <snapchat>Snapchat</snapchat>
                    <telegram>Telegram</telegram>
                    <viber>Viber</viber>
                    <whatsapp>WhatsApp</whatsapp>
                </OptionValues>
            </messaging_apps>
            <games_seen type="TextField">
                <Mask>/^[a-z0-9_]{1,64}(,[a-z0-9_]{1,64})*$/</Mask>
            </games_seen>
        </general>
        <devices type="ArrayField">
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <name type="TextField">
                <Required>Y</Required>
                <Mask>/^[\w\-. ]{1,64}$/u</Mask>
                <ValidationMessage>A short name, up to 64 characters.</ValidationMessage>
            </name>
            <address type="TextField">
                <Required>Y</Required>
                <Mask>/^(((25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3})(\/(3[0-2]|[12]?\d))?|([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})$/</Mask>
                <ValidationMessage>An IPv4 address or CIDR (192.168.1.50, 192.168.1.0/24) or a MAC address (aa:bb:cc:dd:ee:ff).</ValidationMessage>
            </address>
            <mode type="OptionField">
                <Required>Y</Required>
                <Default>schedule</Default>
                <OptionValues>
                    <allow>Always allowed</allow>
                    <block>Always blocked</block>
                    <schedule>Scheduled</schedule>
                </OptionValues>
            </mode>
            <weekdays type="OptionField">
                <Multiple>Y</Multiple>
                <Default>mon,tue,wed,thu,fri,sat,sun</Default>
                <OptionValues>
                    <mon>Monday</mon>
                    <tue>Tuesday</tue>
                    <wed>Wednesday</wed>
                    <thu>Thursday</thu>
                    <fri>Friday</fri>
                    <sat>Saturday</sat>
                    <sun>Sunday</sun>
                </OptionValues>
            </weekdays>
            <allow_from type="TextField">
                <Required>Y</Required>
                <Default>07:00</Default>
                <Mask>/^([01]\d|2[0-3]):([0-5]\d)$/</Mask>
                <ValidationMessage>24-hour time, HH:MM.</ValidationMessage>
            </allow_from>
            <allow_to type="TextField">
                <Required>Y</Required>
                <Default>21:00</Default>
                <Mask>/^([01]\d|2[0-3]):([0-5]\d)$/</Mask>
                <ValidationMessage>24-hour time, HH:MM.</ValidationMessage>
            </allow_to>
            <override type="OptionField">
                <Required>Y</Required>
                <Default>none</Default>
                <OptionValues>
                    <none>No override</none>
                    <allow>Force allow</allow>
                    <block>Force block</block>
                </OptionValues>
            </override>
            <messaging type="OptionField">
                <Required>Y</Required>
                <Default>off</Default>
                <OptionValues>
                    <off>Not blocked</off>
                    <on>Blocked</on>
                    <schedule>Blocked outside allowed hours</schedule>
                </OptionValues>
            </messaging>
            <gaming type="OptionField">
                <Required>Y</Required>
                <Default>off</Default>
                <OptionValues>
                    <off>Not blocked</off>
                    <on>Blocked</on>
                    <schedule>Blocked outside allowed hours</schedule>
                </OptionValues>
            </gaming>
            <description type="TextField">
                <Mask>/^[^&lt;&gt;&quot;'\\]{0,255}$/u</Mask>
                <ValidationMessage>Up to 255 characters. Angle brackets, quotes and backslash are not allowed.</ValidationMessage>
            </description>
        </devices>
        <games type="ArrayField">
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <name type="TextField">
                <Required>Y</Required>
                <Mask>/^[^&lt;&gt;&quot;'\\]{1,64}$/u</Mask>
                <AllowNewlines>N</AllowNewlines>
                <ValidationMessage>A name of up to 64 characters, without angle brackets, quotes or backslash.</ValidationMessage>
            </name>
            <hosts type="HostnameField">
                <AsList>Y</AsList>
                <IpAllowed>N</IpAllowed>
                <ChangeCase>lower</ChangeCase>
                <ValidationMessage>%s is not a host name. An address belongs under Address ranges.</ValidationMessage>
            </hosts>
            <proxy_hosts type="HostnameField">
                <AsList>Y</AsList>
                <IpAllowed>N</IpAllowed>
                <ChangeCase>lower</ChangeCase>
                <ValidationMessage>%s is not a host name. An address belongs under Address ranges.</ValidationMessage>
            </proxy_hosts>
            <ranges type="NetworkField">
                <AsList>Y</AsList>
                <NetMaskRequired>Y</NetMaskRequired>
                <AddressFamily>ipv4</AddressFamily>
                <WildcardEnabled>N</WildcardEnabled>
                <ValidationMessage>Each range is an IPv4 network with its prefix length, such as 192.0.2.0/24.</ValidationMessage>
            </ranges>
        </games>
    </items>
</model>
